# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# Both are required for `npm test` and `npm run dev`. Without them,
# src/carpool/supabaseClient.js throws on import and one test file fails.
# `npm run build` does not need them.
#
# Supabase dashboard, Project Settings, API. The anon key is the publishable
# one and is safe to ship to the browser. Do not put the service role or
# secret key here; nothing in this repo's client code uses it.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional, only for the carpool map views. Google Cloud console.
# VITE_GOOGLE_MAPS_KEY=
# VITE_GOOGLE_MAPS_MAP_ID=
# VITE_GOOGLE_CLIENT_ID=

# Server-side values for api/ live in the Vercel project environment, not here:
#   SUPABASE_URL, SUPABASE_ANON_KEY
#   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET, R2_PUBLIC_BASE
#   VAULT_STORAGE
