{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/events/2026/fall-raffle/countdown.png", "destination": "/api/vault-og?card=raffle-countdown" },
    {
      "source": "/api/nyc-download/:photo",
      "destination": "/api/m3-link?vault=nyc&download=:photo"
    },
    {
      "source": "/api/nyc-sign",
      "destination": "/api/m3-sign?vault=nyc"
    },
    {
      "source": "/nyc-vault/e/:slug/p/:photo",
      "destination": "/api/m3-link?vault=nyc&slug=:slug&photo=:photo"
    },
    {
      "source": "/nyc-vault/e/:slug",
      "destination": "/api/m3-link?vault=nyc&slug=:slug"
    },
    {
      "source": "/api/london-activity",
      "destination": "/api/m3-sign?vault=london-activity"
    },
    {
      "source": "/api/london-stories-webhook",
      "destination": "/api/booth-ingest?source=london-stories"
    },
    {
      "source": "/2028-london/e/:slug/p/:photo",
      "destination": "/api/m3-link?vault=london&slug=:slug&photo=:photo"
    },
    {
      "source": "/2028-london/e/:slug",
      "destination": "/api/m3-link?vault=london&slug=:slug"
    },
    {
      "source": "/api/newsletter-sign",
      "destination": "/api/m3-sign?vault=newsletter"
    },
    {
      "source": "/newsletter/builder",
      "destination": "/newsletter/builder/index.html"
    },
    {
      "source": "/newsletter/september-20",
      "destination": "/newsletter/september-20/index.html"
    },
    {
      "source": "/newsletter",
      "destination": "/api/link?p=newsletter"
    },
    {
      "source": "/newsletter/:slug",
      "destination": "/api/link?p=newsletter&v=:slug"
    },
    {
      "source": "/api/london-sign",
      "destination": "/api/m3-sign?vault=london"
    },
    {
      "source": "/6ps",
      "destination": "/6ps/index.html"
    },
    {
      "source": "/share/:token",
      "destination": "/api/vault-link?share=:token"
    },
    {
      "source": "/feedback/:path*",
      "destination": "/feedback/index.html"
    },
    {
      "source": "/karaoke/tonight",
      "destination": "/karaoke/tonight/index.html"
    },
    {
      "source": "/now",
      "destination": "/now/index.html"
    },
    {
      "source": "/karaoke/playlist",
      "destination": "/karaoke/playlist/index.html"
    },
    {
      "source": "/ami-vault/e/:slug/p/:photo",
      "destination": "/api/vault-link?slug=:slug&photo=:photo"
    },
    {
      "source": "/rcap-capsule/e/:slug/p/:photo",
      "destination": "/api/vault-link?slug=:slug&photo=:photo&vault=rcap"
    },
    {
      "source": "/rsvp/:slug/calendar.ics",
      "destination": "/api/event-ics?slug=:slug"
    },
    {
      "source": "/rsvp/:slug",
      "destination": "/rsvp/index.html"
    },
    {
      "source": "/uniform-exchange/h/:token",
      "destination": "/api/link?p=holder&v=:token"
    },
    {
      "source": "/uniform-exchange/b/:code",
      "destination": "/api/link?p=bin&v=:code"
    },
    {
      "source": "/uniform-exchange/m/:token",
      "destination": "/api/link?p=my&v=:token"
    },
    {
      "source": "/uniform-exchange/storage",
      "destination": "/api/link?p=admin"
    },
    {
      "source": "/ami-vault/e/:slug",
      "destination": "/api/vault-link?slug=:slug"
    },
    {
      "source": "/rcap-capsule/e/:slug",
      "destination": "/api/vault-link?slug=:slug&vault=rcap"
    },
    {
      "source": "/m3-vault/e/:slug",
      "destination": "/api/m3-link?slug=:slug"
    },
    {
      "source": "/e/:slug",
      "destination": "/api/vault-link?slug=:slug"
    },
    {
      "source": "/committeeinterest",
      "destination": "/committee-interest/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/nyc-sendoff/",
      "destination": "/nyc-vault/",
      "permanent": true
    },
    {
      "source": "/nyc-sendoff/:path*",
      "destination": "/nyc-vault/",
      "permanent": true
    },
    {
      "source": "/london-vault/",
      "destination": "/2028-london/",
      "permanent": true
    },
    {
      "source": "/london-vault/:path*",
      "destination": "/2028-london/:path*",
      "permanent": true
    },
    {
      "source": "/karaoke",
      "destination": "/rsvp/karaoke-sept-27",
      "permanent": false
    },
    {
      "source": "/rcap-vault/",
      "destination": "/rcap-capsule/",
      "permanent": true
    },
    {
      "source": "/rcap-vault",
      "destination": "/rcap-capsule/",
      "permanent": true
    },
    {
      "source": "/rcap-vault/:path*",
      "destination": "/rcap-capsule/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/share/:token",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "functions": {
    "api/london-stories-worker.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/ffmpeg-static/ffmpeg",
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "london-instagram-import",
          "maxConcurrency": 1
        }
      ]
    },
    "api/m3-sign.js": {
      "maxDuration": 60,
      "includeFiles": "server/london-dedupe/seed.json"
    }
  }
}
